<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Lucky Garage</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#10151d;color:#fff;font-family:Arial,sans-serif;padding:15px}
header{display:flex;justify-content:space-between;align-items:center;gap:8px}
h1{font-size:23px;color:#8cffad;margin:8px 0}
.balance,.panel,.item{background:#292f40;padding:14px;border-radius:14px;margin:12px 0}
nav,.buttons{display:flex;gap:8px;flex-wrap:wrap;margin:16px 0}
button,select{border:0;border-radius:10px;padding:13px;background:#30384b;color:white;font-size:15px;font-weight:bold}
button{flex:1;cursor:pointer}
button.active,.main{background:#32b96b;color:#08150c}
.plate{background:#f7f7f7;color:#111;border:5px solid #777;border-radius:12px;padding:18px 8px;text-align:center;font-size:30px;font-weight:bold;margin:16px 0}
.muted{color:#b4bdcf;font-size:14px}
.item{margin:10px 0}
.hidden{display:none}
</style>
</head>
<body>
<header>
<div><h1>🍀 Lucky Garage</h1><div class="muted">Уровень 1 · <span id="country">Россия</span></div></div>
<select id="currency" onchange="changeCurrency()">
<option value="RUB">🇷🇺 RUB</option>
<option value="KZT">🇰🇿 KZT</option>
<option value="USD">🇺🇸 USD</option>
</select>
</header>
<div class="balance">💰 Баланс: <b id="money">100000</b> <span id="symbol">₽</span><div id="luck" class="muted">🍀 Удача обычная</div></div>
<nav>
<button class="active" onclick="page('numbers',this)">Номера</button>
<button onclick="page('cars',this)">Машины</button>
<button onclick="page('shop',this)">Магазин</button>
</nav>
<section id="numbers">
<div class="panel">
<h3>🎰 Рулетка номеров</h3>
<div class="muted">Испытай удачу и получи новый номер!</div>
<div class="plate" id="plate">A777AA 777</div>
<div id="rarity" style="text-align:center">Обычный номер</div>
<div id="prize" style="text-align:center;margin:10px">Стоимость: —</div>
<div class="buttons">
<button class="main" onclick="spin(1)">Крутить · 1 000 <span class="sym">₽</span></button>
<button onclick="spin(5)">×5</button>
</div>
</div>
<div class="panel"><h3>🎁 Подарок на день</h3><p id="gifttext">Забери ежедневный подарок!</p><button class="main" onclick="gift()">Получить подарок</button></div>
</section>
<section id="cars" class="hidden">
<div class="panel"><h2>🚘 Машины</h2><p class="muted">Открывай контейнеры и собирай коллекцию.</p>
<div class="item">📦 Обычный контейнер — 10 000 <span class="sym">₽</span><button onclick="carCase(10000,'Обычный')">Открыть</button></div>
<div class="item">📦 Редкий контейнер — 30 000 <span class="sym">₽</span><button onclick="carCase(30000,'Редкий')">Открыть</button></div>
<div class="item">📦 Эпический контейнер — 100 000 <span class="sym">₽</span><button onclick="carCase(100000,'Эпический')">Открыть</button></div>
<div class="item">📦 Легендарный контейнер — 300 000 <span class="sym">₽</span><button onclick="carCase(300000,'Легендарный')">Открыть</button></div>
</div>
<div class="panel"><h3>🚗 Автопарк</h3><div id="garage">Пока машин нет.</div></div>
</section>
<section id="shop" class="hidden">
<div class="panel"><h2>🛒 Магазин</h2><p>Пополнение баланса и покупка улучшений пока недоступны.</p><h3>🎡 Колесо удачи</h3><button onclick="wheel()">Испытать удачу · 10 000 <span class="sym">₽</span></button><h3>🍀 Удача ×2</h3><button onclick="luckBoost()">Активировать · 10 000 <span class="sym">₽</span></button></div>
<div class="panel"><h3>📜 Правила</h3><p>Играй честно, собирай номера и машины. Баланс хранится в этом браузере. Не очищай данные браузера, чтобы не потерять прогресс.</p></div>
</section>
<script>
let money=100000, currency='RUB', symbol='₽', cars=[], numbers=[], giftDay=0, luck=1;
const symbols={RUB:'₽',KZT:'₸',USD:'$'};
function save(){try{localStorage.setItem('luckyGarage',JSON.stringify({money,currency,cars,numbers,giftDay,luck}))}catch(e){}}
function load(){try{let d=JSON.parse(localStorage.getItem('luckyGarage'));if(d){money=d.money??money;currency=d.currency||currency;cars=d.cars||[];numbers=d.numbers||[];giftDay=d.giftDay||0;luck=d.luck||1}}catch(e){}}
function render(){symbol=symbols[currency];document.getElementById('money').textContent=Math.floor(money).toLocaleString('ru-RU');document.getElementById('symbol').textContent=symbol;document.querySelectorAll('.sym').forEach(e=>e.textContent=symbol);document.getElementById('currency').value=currency;document.getElementById('country').textContent={RUB:'Россия',KZT:'Казахстан',USD:'США'}[currency];document.getElementById('luck').textContent=luck>1?'🍀 Удача ×'+luck:'🍀 Удача обычная';document.getElementById('garage').innerHTML=cars.length?cars.map(c=>'🚘 '+c+' <button onclick="sellCar('+cars.indexOf(c)+')">Продать</button>').join('<hr>'):'Пока машин нет.';document.getElementById('gifttext').textContent=giftDay>=3?'Ежедневные подарки получены!':'Доступен подарок дня '+(giftDay+1)}
function changeCurrency(){currency=document.getElementById('currency').value;render();save()}
function page(id,btn){document.querySelectorAll('section').forEach(s=>s.classList.add('hidden'));document.getElementById(id).classList.remove('hidden');document.querySelectorAll('nav button').forEach(b=>b.classList.remove('active'));btn.classList.add('active')}
function rand(a,b){return Math.floor(Math.random()*(b-a+1))+a}
function spin(count){let cost=1000*count;if(money<cost){alert('Недостаточно денег!');return}money-=cost;let r=Math.random()*100,rarity,value;if(r<.00001){rarity='Админ';value=rand(5000000,15000000)}else if(r<.10001){rarity='Секретный';value=rand(500000,1000000)}else if(r<4.10001){rarity='Мифический';value=rand(160000,290000)}else if(r<4.50001){rarity='Легендарный';value=rand(50000,70000)}else if(r<7.00001){rarity='Эпический';value=rand(4200,7000)}else if(r<15.00001){rarity='Редкий';value=rand(700,1800)}else if(r<35.00001){rarity='Необычный';value=rand(150,380)}else{rarity='Обычный';value=rand(1,130)}value*=luck;let plate=String.fromCharCode(65+rand(0,25))+rand(100,999)+String.fromCharCode(65+rand(0,25))+String.fromCharCode(65+rand(0,25))+' '+rand(1,999);document.getElementById('plate').textContent=plate;document.getElementById('rarity').textContent=rarity+' номер';document.getElementById('prize').textContent='Стоимость: '+Math.floor(value).toLocaleString('ru-RU')+' '+symbol;numbers.push({plate,rarity,value});save();render()}
function gift(){if(giftDay>=3){alert('Все подарки уже забраны!');return}let amounts=[20000,50000,100000];money+=amounts[giftDay];alert('Подарок: '+amounts[giftDay].toLocaleString('ru-RU')+' '+symbol);giftDay++;save();render()}
function carCase(cost,level){if(money<cost){alert('Недостаточно денег!');return}money-=cost;let pool=level==='Обычный'?['Fiat Panda','Toyota Yaris','Honda Civic']:level==='Редкий'?['BMW M3','Audi RS5','Mercedes C63']:level==='Эпический'?['Porsche 911','Lamborghini Huracan','Ferrari F8']:['Bugatti Chiron','Ferrari SF90','Lamborghini Aventador','McLaren P1'];let c=pool[rand(0,pool.length-1)];cars.push(c);alert('Ты получил машину: '+c);save();render()}
function sellCar(i){if(!cars[i])return;money+=10000;alert('Машина продана за 10 000 '+symbol);cars.splice(i,1);save();render()}
function wheel(){if(money<10000){alert('Недостаточно денег!');return}money-=10000;let win=rand(0,4);if(win===0){money+=50000;alert('🎉 Выигрыш 50 000 '+symbol)}else alert('В следующий раз повезёт!');save();render()}
function luckBoost(){if(money<10000){alert('Недостаточно денег!');return}money-=10000;luck=2;alert('Удача ×2 активирована на время этой сессии!');save();render()}
load();render();
</script>
</body>
</html>
